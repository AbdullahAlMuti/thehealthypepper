{%- comment -%}
  Emits BreadcrumbList structured data.

  The theme previously shipped no breadcrumb schema on any template, so
  search engines had no declared site hierarchy and results rendered with a
  bare URL instead of a navigable trail.

  The trail mirrors how a visitor actually arrived: a product reached
  through a collection includes that collection, matching Google's
  requirement that breadcrumb markup reflect a real path to the page.

  Emits nothing on templates where a hierarchy would be meaningless
  (index, cart, search, customer accounts, password).

  Usage:
    {% render 'breadcrumb-schema' %}
{%- endcomment -%}

{%- liquid
  assign emit_breadcrumb = false
  case request.page_type
    when 'product', 'collection', 'article', 'blog', 'page'
      assign emit_breadcrumb = true
  endcase
-%}

{%- if emit_breadcrumb -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          {%- comment -%}
            Literal rather than a translation key: adding one would require
            the same key in all 52 locale files to satisfy theme-check's
            MatchingTranslations rule, and seeding English into every
            locale is worse than leaving this untranslated. Revisit if the
            store enables additional languages.
          {%- endcomment -%}
          "name": "Home",
          "item": {{ request.origin | json }}
        }
        {%- case request.page_type -%}
          {%- when 'product' -%}
            {%- if collection.title != blank -%}
              ,{
                "@type": "ListItem",
                "position": 2,
                "name": {{ collection.title | json }},
                "item": {{ request.origin | append: collection.url | json }}
              },
              {
                "@type": "ListItem",
                "position": 3,
                "name": {{ product.title | json }},
                "item": {{ request.origin | append: product.url | json }}
              }
            {%- else -%}
              ,{
                "@type": "ListItem",
                "position": 2,
                "name": {{ product.title | json }},
                "item": {{ request.origin | append: product.url | json }}
              }
            {%- endif -%}

          {%- when 'collection' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": {{ request.origin | append: collection.url | json }}
            }

          {%- when 'blog' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | json }},
              "item": {{ request.origin | append: blog.url | json }}
            }

          {%- when 'article' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | json }},
              "item": {{ request.origin | append: blog.url | json }}
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ article.title | json }},
              "item": {{ request.origin | append: article.url | json }}
            }

          {%- when 'page' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ page.title | json }},
              "item": {{ request.origin | append: page.url | json }}
            }
        {%- endcase -%}
      ]
    }
  </script>
{%- endif -%}
