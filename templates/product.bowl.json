        "custom_liquid": "<style>\n  .pet-problem-banner {\n    padding: 40px 14px;\n    background: #ffffff;\n    font-family: Arial, Helvetica, sans-serif;\n  }\n\n  .pet-problem-wrap {\n    max-width: 1120px;\n    margin: 0 auto;\n  }\n\n  .pet-problem-header {\n    max-width: 720px;\n    margin: 0 auto 26px;\n    text-align: center;\n  }\n\n  .pet-problem-eyebrow {\n    margin: 0 0 10px;\n    font-size: 13px;\n    line-height: 1.2;\n    font-weight: 800;\n    letter-spacing: 0.8px;\n    text-transform: uppercase;\n    color: #1684e8;\n  }\n\n  .pet-problem-title {\n    margin: 0 0 10px;\n    font-size: clamp(27px, 4vw, 42px);\n    line-height: 1.08;\n    font-weight: 900;\n    color: #111827;\n    letter-spacing: -0.6px;\n  }\n\n  .pet-problem-title span {\n    color: #1684e8;\n  }\n\n  .pet-problem-subtitle {\n    margin: 0;\n    font-size: clamp(14px, 2vw, 17px);\n    line-height: 1.55;\n    font-weight: 500;\n    color: #4b5563;\n  }\n\n  .pet-problem-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: clamp(10px, 2vw, 16px);\n  }\n\n  .pet-problem-card {\n    background: #ffffff;\n    border: 1px solid #e5e7eb;\n    border-radius: 16px;\n    overflow: hidden;\n  }\n\n  .pet-problem-img-wrap {\n    position: relative;\n    background: #f5f7fb;\n  }\n\n  .pet-problem-card img {\n    width: 100%;\n    aspect-ratio: 1 / 0.9;\n    object-fit: cover;\n    display: block;\n  }\n\n  .pet-problem-label {\n    position: absolute;\n    left: 10px;\n    bottom: 10px;\n    padding: 6px 9px;\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.92);\n    color: #111827;\n    font-size: 11.5px;\n    line-height: 1;\n    font-weight: 800;\n  }\n\n  .pet-problem-content {\n    padding: 14px 13px 15px;\n    text-align: left;\n  }\n\n  .pet-problem-text {\n    margin: 0 0 6px;\n    font-size: clamp(14px, 2vw, 16px);\n    line-height: 1.25;\n    font-weight: 850;\n    color: #111827;\n  }\n\n  .pet-problem-note {\n    margin: 0;\n    font-size: 12.5px;\n    line-height: 1.45;\n    font-weight: 500;\n    color: #6b7280;\n  }\n\n  .pet-brand-solution {\n    margin-top: 22px;\n    display: grid;\n    grid-template-columns: 1.15fr 0.85fr;\n    gap: 18px;\n    align-items: stretch;\n  }\n\n  .pet-brand-story {\n    padding: 20px;\n    border-radius: 18px;\n    background: #f3f8ff;\n    border: 1px solid #dbeaff;\n  }\n\n  .pet-brand-story-title {\n    margin: 0 0 8px;\n    font-size: clamp(19px, 2.5vw, 26px);\n    line-height: 1.18;\n    font-weight: 900;\n    color: #0f3f89;\n    letter-spacing: -0.4px;\n  }\n\n  .pet-brand-story-title span {\n    color: #1684e8;\n  }\n\n  .pet-brand-story-copy {\n    margin: 0;\n    font-size: 14.5px;\n    line-height: 1.6;\n    font-weight: 500;\n    color: #315c9b;\n  }\n\n  .pet-brand-points {\n    padding: 20px;\n    border-radius: 18px;\n    background: #ffffff;\n    border: 1px solid #e5e7eb;\n    display: grid;\n    gap: 11px;\n  }\n\n  .pet-brand-point {\n    display: grid;\n    grid-template-columns: 22px 1fr;\n    gap: 9px;\n    align-items: start;\n  }\n\n  .pet-brand-check {\n    width: 20px;\n    height: 20px;\n    border-radius: 50%;\n    background: #1684e8;\n    color: #ffffff;\n    font-size: 12px;\n    font-weight: 900;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-top: 1px;\n  }\n\n  .pet-brand-point strong {\n    display: block;\n    margin-bottom: 2px;\n    font-size: 13.5px;\n    line-height: 1.3;\n    font-weight: 850;\n    color: #111827;\n  }\n\n  .pet-brand-point span {\n    display: block;\n    font-size: 12.5px;\n    line-height: 1.4;\n    font-weight: 500;\n    color: #6b7280;\n  }\n\n  .pet-brand-trust {\n    margin-top: 16px;\n    padding-top: 14px;\n    border-top: 1px solid #e5e7eb;\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 8px;\n  }\n\n  .pet-brand-trust span {\n    font-size: 12.5px;\n    line-height: 1;\n    font-weight: 700;\n    color: #0b3f91;\n    background: #f3f8ff;\n    border-radius: 999px;\n    padding: 7px 10px;\n  }\n\n  @media (max-width: 768px) {\n    .pet-problem-banner {\n      padding: 34px 12px;\n    }\n\n    .pet-problem-header {\n      margin-bottom: 22px;\n    }\n\n    .pet-problem-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n\n    .pet-problem-card {\n      border-radius: 14px;\n    }\n\n    .pet-problem-content {\n      padding: 12px 11px 13px;\n    }\n\n    .pet-brand-solution {\n      grid-template-columns: 1fr;\n      gap: 12px;\n    }\n\n    .pet-brand-story,\n    .pet-brand-points {\n      padding: 16px;\n      border-radius: 16px;\n    }\n\n    .pet-brand-story-copy {\n      font-size: 13.8px;\n    }\n  }\n\n  @media (max-width: 380px) {\n    .pet-problem-grid {\n      gap: 10px;\n    }\n\n    .pet-problem-text {\n      font-size: 13.5px;\n    }\n\n    .pet-problem-note {\n      font-size: 11.7px;\n    }\n\n    .pet-brand-trust span {\n      font-size: 12px;\n      padding: 6px 9px;\n    }\n  }\n</style>\n\n<section class=\"pet-problem-banner\">\n  <div class=\"pet-problem-wrap\">\n\n    <div class=\"pet-problem-header\">\n      <p class=\"pet-problem-eyebrow\">Mealtime Enrichment</p>\n\n      <h2 class=\"pet-problem-title\">\n        Built for Pets Who Need <span>More Than a Bowl</span>\n      </h2>\n\n      <p class=\"pet-problem-subtitle\">\n        A simple enrichment feeder designed to make treat time slower, cleaner, and more engaging for everyday use.\n      </p>\n    </div>\n\n    <div class=\"pet-problem-grid\">\n      <div class=\"pet-problem-card\">\n        <div class=\"pet-problem-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0964/9419/0939/files/1_b6a9f306-d11d-4bb7-805e-bd8d79bbb544.png?v=1778179984\" alt=\"Dog eating too fast\">\n          <span class=\"pet-problem-label\">Fast eating</span>\n        </div>\n        <div class=\"pet-problem-content\">\n          <p class=\"pet-problem-text\">Encourages slower feeding</p>\n          <p class=\"pet-problem-note\">Helps pets work for their reward instead of finishing treats too quickly.</p>\n        </div>\n      </div>\n\n      <div class=\"pet-problem-card\">\n        <div class=\"pet-problem-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0964/9419/0939/files/2.png?v=1778179983\" alt=\"Pet making a mess while eating\">\n          <span class=\"pet-problem-label\">Messy snacks</span>\n        </div>\n        <div class=\"pet-problem-content\">\n          <p class=\"pet-problem-text\">Designed for cleaner treat time</p>\n          <p class=\"pet-problem-note\">Helps keep spreads and wet food more contained during play.</p>\n        </div>\n      </div>\n\n      <div class=\"pet-problem-card\">\n        <div class=\"pet-problem-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0964/9419/0939/files/3.png?v=1778179983\" alt=\"Pet getting bored easily\">\n          <span class=\"pet-problem-label\">Boredom</span>\n        </div>\n        <div class=\"pet-problem-content\">\n          <p class=\"pet-problem-text\">Adds mental stimulation</p>\n          <p class=\"pet-problem-note\">Turns favorite foods into a more interactive, longer-lasting activity.</p>\n        </div>\n      </div>\n\n      <div class=\"pet-problem-card\">\n        <div class=\"pet-problem-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0964/9419/0939/files/4.png?v=1778179983\" alt=\"Dog showing anxiety\">\n          <span class=\"pet-problem-label\">Restless pets</span>\n        </div>\n        <div class=\"pet-problem-content\">\n          <p class=\"pet-problem-text\">Keeps pets calmly engaged</p>\n          <p class=\"pet-problem-note\">Provides a focused reward-based activity during quiet time at home.</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"pet-brand-solution\">\n      <div class=\"pet-brand-story\">\n        <h3 class=\"pet-brand-story-title\">\n          A better way to serve their <span>favorite treats.</span>\n        </h3>\n        <p class=\"pet-brand-story-copy\">\n          Fill it with yogurt, broth, peanut butter, or wet food. As your pet rolls and licks, snack time becomes a slower, more enriching routine that supports calmer behavior and cleaner feeding.\n        </p>\n\n        <div class=\"pet-brand-trust\">\n          <span>Food-grade material</span>\n          <span>Easy to clean</span>\n          <span>For dogs &amp; cats</span>\n        </div>\n      </div>\n\n      <div class=\"pet-brand-points\">\n        <div class=\"pet-brand-point\">\n          <span class=\"pet-brand-check\">\u2713</span>\n          <div>\n            <strong>Slow-feeding support</strong>\n            <span>Helps make treats last longer.</span>\n          </div>\n        </div>\n\n        <div class=\"pet-brand-point\">\n          <span class=\"pet-brand-check\">\u2713</span>\n          <div>\n            <strong>Daily enrichment</strong>\n            <span>Great for keeping pets occupied at home.</span>\n          </div>\n        </div>\n\n        <div class=\"pet-brand-point\">\n          <span class=\"pet-brand-check\">\u2713</span>\n          <div>\n            <strong>Rolling ball design</strong>\n            <span>Encourages natural curiosity and play.</span>\n          </div>\n        </div>\n\n        <div class=\"pet-brand-point\">\n          <span class=\"pet-brand-check\">\u2713</span>\n          <div>\n            <strong>Cleaner feeding</strong>\n            <span>Made to help reduce spills and mess.</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n  </div>\n</section>",
