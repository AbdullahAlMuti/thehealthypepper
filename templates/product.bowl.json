        "custom_liquid": "<div class=\"pawosa-results\">\n  <div class=\"pawosa-results__header\">\n    <p class=\"pawosa-results__eyebrow\">Pawosa Rolling Lick Bowl</p>\n\n    <h2>\n      A Calmer Way to Make Treat Time\n      <span>Slower, Cleaner & More Engaging</span>\n    </h2>\n\n    <p>\n      Designed for pets who eat too fast, get bored easily, or need a more enriching snack routine at home.\n    </p>\n  </div>\n\n  <div class=\"pawosa-results__top\">\n    <div class=\"pawosa-results__image\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0964/9419/0939/files/1_b6a9f306-d11d-4bb7-805e-bd8d79bbb544.png?v=1778179984\"\n        alt=\"Dog using Pawosa Rolling Lick Bowl\"\n      >\n    </div>\n\n    <div class=\"pawosa-results__benefits\">\n      <div class=\"result-card\">\n        <div class=\"result-icon\">\u23f1\ufe0f</div>\n        <h3>Supports Slower Eating</h3>\n        <p>Encourages pets to lick and work for treats instead of finishing food too quickly.</p>\n      </div>\n\n      <div class=\"result-card\">\n        <div class=\"result-icon\">\ud83e\udde0</div>\n        <h3>Daily Mental Enrichment</h3>\n        <p>Turns yogurt, broth, wet food, or peanut butter into a longer-lasting activity.</p>\n      </div>\n\n      <div class=\"result-card\">\n        <div class=\"result-icon\">\ud83e\uddfc</div>\n        <h3>Helps Reduce Mess</h3>\n        <p>The anti-spill design helps keep soft treats more contained during use.</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"pawosa-results__compare\">\n    <div class=\"compare-card before\">\n      <div class=\"compare-heading\">\n        <span>Before</span>\n        <h3>Traditional Treat Time</h3>\n      </div>\n\n      <div class=\"compare-content\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0964/9419/0939/files/2.png?v=1778179983\"\n          alt=\"Pet making a mess with traditional feeding\"\n        >\n\n        <ul>\n          <li>Eats treats too quickly</li>\n          <li>More spills and cleanup</li>\n          <li>Gets bored soon after</li>\n          <li>Less mental stimulation</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"compare-card after\">\n      <div class=\"compare-heading\">\n        <span>After</span>\n        <h3>Pawosa Rolling Lick Bowl</h3>\n      </div>\n\n      <div class=\"compare-content\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0964/9419/0939/files/h3.png?v=1778180857\"\n          alt=\"Dog using Pawosa Rolling Lick Bowl\"\n        >\n\n        <ul>\n          <li>Encourages slower licking</li>\n          <li>Keeps treats more contained</li>\n          <li>Helps pets stay engaged</li>\n          <li>Adds enrichment to daily routine</li>\n        </ul>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"pawosa-results__trust\">\n    <div>\n      <strong>Food-Grade Material</strong>\n      <span>Made for everyday treat use</span>\n    </div>\n\n    <div>\n      <strong>Easy to Clean</strong>\n      <span>Simple design for daily routines</span>\n    </div>\n\n    <div>\n      <strong>Dogs &amp; Cats Friendly</strong>\n      <span>Works with soft treats and wet food</span>\n    </div>\n\n    <div>\n      <strong>Pet-Friendly Design</strong>\n      <span>Built for slower, calmer enrichment</span>\n    </div>\n  </div>\n</div>\n\n<style>\n  .pawosa-results {\n    max-width: 1280px;\n    margin: 0 auto;\n    padding: 48px 24px;\n    background: linear-gradient(180deg, #ffffff 0%, #f5f9ff 100%);\n    border-radius: 24px;\n    font-family: Arial, Helvetica, sans-serif;\n    color: #07172f;\n    overflow: hidden;\n  }\n\n  .pawosa-results * {\n    box-sizing: border-box;\n  }\n\n  .pawosa-results__header {\n    max-width: 820px;\n    margin: 0 auto 30px;\n    text-align: center;\n  }\n\n  .pawosa-results__eyebrow {\n    display: inline-flex;\n    margin: 0 0 12px;\n    padding: 7px 14px;\n    border-radius: 999px;\n    background: #eef6ff;\n    color: #1478ff;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 800;\n    letter-spacing: 0.05em;\n    text-transform: uppercase;\n  }\n\n  .pawosa-results__header h2 {\n    margin: 0;\n    font-size: clamp(32px, 5vw, 58px);\n    line-height: 1.08;\n    font-weight: 900;\n    letter-spacing: -0.04em;\n    color: #07172f;\n  }\n\n  .pawosa-results__header h2 span {\n    display: block;\n    color: #1478ff;\n  }\n\n  .pawosa-results__header p {\n    max-width: 700px;\n    margin: 14px auto 0;\n    font-size: clamp(15px, 2vw, 18px);\n    line-height: 1.55;\n    color: #536176;\n    font-weight: 500;\n  }\n\n  .pawosa-results__top {\n    display: grid;\n    grid-template-columns: 34% 1fr;\n    gap: 24px;\n    align-items: stretch;\n  }\n\n  .pawosa-results__image img {\n    width: 100%;\n    height: 100%;\n    min-height: 360px;\n    object-fit: cover;\n    border-radius: 20px;\n    display: block;\n  }\n\n  .pawosa-results__benefits {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 16px;\n    align-items: stretch;\n  }\n\n  .result-card {\n    background: #ffffff;\n    border-radius: 18px;\n    padding: 28px 20px;\n    text-align: center;\n    border: 1px solid #dbeaff;\n  }\n\n  .result-icon {\n    width: 74px;\n    height: 74px;\n    margin: 0 auto 16px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: #f1f7ff;\n    border-radius: 50%;\n    font-size: 34px;\n  }\n\n  .result-card h3 {\n    margin: 0 0 10px;\n    font-size: clamp(18px, 1.8vw, 22px);\n    line-height: 1.2;\n    font-weight: 900;\n    color: #101828;\n  }\n\n  .result-card p {\n    margin: 0;\n    font-size: 15px;\n    line-height: 1.5;\n    color: #536176;\n    font-weight: 500;\n  }\n\n  .pawosa-results__compare {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 20px;\n    margin-top: 24px;\n    align-items: stretch;\n  }\n\n  .compare-card {\n    background: #ffffff;\n    border-radius: 20px;\n    padding: 24px;\n    border: 1px solid #dbeaff;\n  }\n\n  .compare-heading {\n    margin-bottom: 18px;\n  }\n\n  .compare-heading span {\n    display: inline-flex;\n    margin-bottom: 8px;\n    padding: 6px 10px;\n    border-radius: 999px;\n    font-size: 12px;\n    line-height: 1;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n  }\n\n  .compare-card.before .compare-heading span {\n    background: #fff1f1;\n    color: #d92d20;\n  }\n\n  .compare-card.after .compare-heading span {\n    background: #eef6ff;\n    color: #1478ff;\n  }\n\n  .compare-heading h3 {\n    margin: 0;\n    font-size: clamp(20px, 2vw, 26px);\n    line-height: 1.18;\n    color: #07172f;\n    font-weight: 900;\n    letter-spacing: -0.03em;\n  }\n\n  .compare-content {\n    display: grid;\n    grid-template-columns: 44% 1fr;\n    gap: 18px;\n    align-items: center;\n  }\n\n  .compare-content img {\n    width: 100%;\n    aspect-ratio: 1.25 / 1;\n    object-fit: cover;\n    border-radius: 14px;\n    display: block;\n  }\n\n  .compare-content ul {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n  }\n\n  .compare-content li {\n    position: relative;\n    margin-bottom: 11px;\n    padding-left: 28px;\n    font-size: 15px;\n    line-height: 1.35;\n    color: #344054;\n    font-weight: 600;\n  }\n\n  .compare-content li:last-child {\n    margin-bottom: 0;\n  }\n\n  .compare-card.before li::before {\n    content: \"\u00d7\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    background: #ef3b3b;\n    color: #ffffff;\n    width: 19px;\n    height: 19px;\n    border-radius: 50%;\n    font-size: 14px;\n    line-height: 19px;\n    text-align: center;\n    font-weight: 900;\n  }\n\n  .compare-card.after li::before {\n    content: \"\u2713\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    background: #1478ff;\n    color: #ffffff;\n    width: 19px;\n    height: 19px;\n    border-radius: 50%;\n    font-size: 12px;\n    line-height: 19px;\n    text-align: center;\n    font-weight: 900;\n  }\n\n  .pawosa-results__trust {\n    margin-top: 22px;\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    background: #ffffff;\n    border: 1px solid #dbeaff;\n    border-radius: 18px;\n    overflow: hidden;\n  }\n\n  .pawosa-results__trust div {\n    padding: 17px 14px;\n    text-align: center;\n    border-right: 1px solid #dbeaff;\n  }\n\n  .pawosa-results__trust div:last-child {\n    border-right: none;\n  }\n\n  .pawosa-results__trust strong {\n    display: block;\n    margin-bottom: 5px;\n    font-size: 14.5px;\n    line-height: 1.25;\n    font-weight: 900;\n    color: #0f3f89;\n  }\n\n  .pawosa-results__trust span {\n    display: block;\n    font-size: 12.5px;\n    line-height: 1.35;\n    font-weight: 500;\n    color: #64748b;\n  }\n\n  @media (max-width: 1100px) {\n    .pawosa-results__top {\n      grid-template-columns: 1fr;\n    }\n\n    .pawosa-results__image img {\n      max-height: 420px;\n    }\n\n    .pawosa-results__benefits {\n      grid-template-columns: repeat(3, 1fr);\n    }\n\n    .pawosa-results__trust {\n      grid-template-columns: repeat(2, 1fr);\n    }\n\n    .pawosa-results__trust div:nth-child(2) {\n      border-right: none;\n    }\n\n    .pawosa-results__trust div:nth-child(1),\n    .pawosa-results__trust div:nth-child(2) {\n      border-bottom: 1px solid #dbeaff;\n    }\n  }\n\n  @media (max-width: 768px) {\n    .pawosa-results {\n      padding: 34px 14px;\n      border-radius: 18px;\n    }\n\n    .pawosa-results__header {\n      margin-bottom: 24px;\n    }\n\n    .pawosa-results__header h2 {\n      font-size: 34px;\n    }\n\n    .pawosa-results__benefits {\n      grid-template-columns: 1fr;\n      gap: 14px;\n    }\n\n    .result-card {\n      padding: 22px 18px;\n    }\n\n    .result-icon {\n      width: 64px;\n      height: 64px;\n      font-size: 30px;\n      margin-bottom: 14px;\n    }\n\n    .pawosa-results__compare {\n      grid-template-columns: 1fr;\n      gap: 16px;\n    }\n\n    .compare-card {\n      padding: 20px 16px;\n    }\n\n    .compare-heading {\n      text-align: center;\n    }\n\n    .compare-content {\n      grid-template-columns: 1fr;\n    }\n\n    .compare-content li {\n      font-size: 14.5px;\n    }\n\n    .pawosa-results__trust {\n      grid-template-columns: 1fr;\n    }\n\n    .pawosa-results__trust div {\n      border-right: none;\n      border-bottom: 1px solid #dbeaff;\n    }\n\n    .pawosa-results__trust div:last-child {\n      border-bottom: none;\n    }\n  }\n\n  @media (max-width: 420px) {\n    .pawosa-results {\n      padding-left: 12px;\n      padding-right: 12px;\n    }\n\n    .pawosa-results__header h2 {\n      font-size: 30px;\n    }\n\n    .pawosa-results__header p {\n      font-size: 14px;\n    }\n\n    .result-card p,\n    .compare-content li {\n      font-size: 13.5px;\n    }\n\n    .pawosa-results__trust strong {\n      font-size: 14px;\n    }\n\n    .pawosa-results__trust span {\n      font-size: 12px;\n    }\n  }\n</style>",
