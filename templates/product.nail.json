    "custom_liquid_xERhcH": {
      "type": "custom-liquid",
      "name": "Why Need",
      "settings": {
        "display_id": false,
        "visibility": "always-display",
        "custom_liquid": "<div class=\"custom-liquid-reference-block\">\n  <style>\n    .custom-liquid-reference-block,\n    .custom-liquid-reference-block * {\n      box-sizing: border-box;\n    }\n\n    .custom-liquid-reference-block {\n      width: 100%;\n      padding: clamp(28px, 4vw, 56px) 16px clamp(22px, 3vw, 36px);\n      background: #fff8ed;\n      color: #102844;\n      overflow: hidden;\n      font-family: Arial, Helvetica, sans-serif;\n    }\n\n    .custom-liquid-reference-block .clrb-shell {\n      width: min(100%, 1480px);\n      margin: 0 auto;\n    }\n\n    .custom-liquid-reference-block .clrb-heading {\n      max-width: 980px;\n      margin: 0 auto clamp(18px, 2.4vw, 30px);\n      text-align: center;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(34px, 4.4vw, 68px);\n      line-height: 0.94;\n      font-weight: 900;\n      letter-spacing: -0.06em;\n      color: #102844;\n    }\n\n    .custom-liquid-reference-block .clrb-heading span {\n      color: #0b7f88;\n      font-style: italic;\n    }\n\n    .custom-liquid-reference-block .clrb-grid {\n      display: grid;\n      grid-template-columns: repeat(4, minmax(0, 1fr));\n      gap: clamp(16px, 1.8vw, 28px);\n      align-items: stretch;\n    }\n\n    .custom-liquid-reference-block .clrb-card {\n      min-width: 0;\n      padding: clamp(12px, 1.15vw, 17px);\n      background: #fffdf8;\n      border: 1px solid #ead9c3;\n      border-radius: clamp(18px, 1.5vw, 24px);\n    }\n\n    .custom-liquid-reference-block .clrb-card-head {\n      display: grid;\n      grid-template-columns: clamp(54px, 5vw, 78px) minmax(0, 1fr);\n      gap: clamp(9px, 0.9vw, 14px);\n      align-items: center;\n      min-height: clamp(82px, 6.2vw, 104px);\n      margin-bottom: clamp(10px, 1vw, 14px);\n    }\n\n    .custom-liquid-reference-block .clrb-icon {\n      width: clamp(54px, 5vw, 78px);\n      height: clamp(54px, 5vw, 78px);\n      border: 3px solid #0b7f88;\n      border-radius: 999px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      color: #0b7f88;\n      background: #e9f8f8;\n      flex: 0 0 auto;\n    }\n\n    .custom-liquid-reference-block .clrb-icon svg {\n      width: 70%;\n      height: 70%;\n      display: block;\n      stroke: currentColor;\n      fill: none;\n      stroke-width: 4.5;\n      stroke-linecap: round;\n      stroke-linejoin: round;\n    }\n\n    .custom-liquid-reference-block .clrb-title {\n      margin: 0 0 4px;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(17px, 1.35vw, 24px);\n      line-height: 0.98;\n      font-weight: 900;\n      letter-spacing: -0.045em;\n      color: #102844;\n    }\n\n    .custom-liquid-reference-block .clrb-copy {\n      margin: 0;\n      max-width: 250px;\n      font-size: clamp(12.5px, 0.96vw, 16px);\n      line-height: 1.26;\n      font-weight: 800;\n      color: #5a4d42;\n      letter-spacing: -0.018em;\n    }\n\n    .custom-liquid-reference-block .clrb-image-wrap {\n      width: 100%;\n      aspect-ratio: 2.45 / 1;\n      overflow: hidden;\n      border-radius: clamp(12px, 1vw, 16px);\n      background: #eadfce;\n      border: 1px solid #ead9c3;\n    }\n\n    .custom-liquid-reference-block .clrb-image {\n      width: 100%;\n      height: 100%;\n      display: block;\n      object-fit: cover;\n    }\n\n    .custom-liquid-reference-block .clrb-footer {\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      gap: clamp(10px, 1vw, 15px);\n      margin-top: clamp(18px, 2vw, 28px);\n      text-align: center;\n      color: #102844;\n    }\n\n    .custom-liquid-reference-block .clrb-paw {\n      width: clamp(34px, 3vw, 50px);\n      height: clamp(34px, 3vw, 50px);\n      color: #0b7f88;\n      flex: 0 0 auto;\n    }\n\n    .custom-liquid-reference-block .clrb-paw svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n      fill: currentColor;\n    }\n\n    .custom-liquid-reference-block .clrb-footer-text {\n      margin: 0;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(22px, 2vw, 34px);\n      line-height: 1.02;\n      font-weight: 900;\n      letter-spacing: -0.05em;\n      color: #102844;\n    }\n\n    .custom-liquid-reference-block .clrb-footer-text span {\n      color: #0b7f88;\n      font-style: italic;\n    }\n\n    @media (max-width: 1180px) {\n      .custom-liquid-reference-block .clrb-grid {\n        gap: 16px;\n      }\n\n      .custom-liquid-reference-block .clrb-card {\n        padding: 12px;\n      }\n\n      .custom-liquid-reference-block .clrb-card-head {\n        grid-template-columns: 56px 1fr;\n        gap: 10px;\n      }\n\n      .custom-liquid-reference-block .clrb-icon {\n        width: 56px;\n        height: 56px;\n        border-width: 2.5px;\n      }\n    }\n\n    @media (max-width: 989px) {\n      .custom-liquid-reference-block {\n        padding: 34px 16px 28px;\n      }\n\n      .custom-liquid-reference-block .clrb-grid {\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        gap: 18px;\n      }\n\n      .custom-liquid-reference-block .clrb-card-head {\n        min-height: 82px;\n      }\n\n      .custom-liquid-reference-block .clrb-copy {\n        max-width: none;\n      }\n\n      .custom-liquid-reference-block .clrb-image-wrap {\n        aspect-ratio: 2.45 / 1;\n      }\n    }\n\n    @media (max-width: 640px) {\n      .custom-liquid-reference-block {\n        padding: 30px 10px 24px;\n      }\n\n      .custom-liquid-reference-block .clrb-heading {\n        max-width: 365px;\n        margin-bottom: 16px;\n        font-size: clamp(35px, 9.8vw, 46px);\n        line-height: 0.96;\n      }\n\n      .custom-liquid-reference-block .clrb-grid {\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        gap: 10px;\n      }\n\n      .custom-liquid-reference-block .clrb-card {\n        border-radius: 16px;\n        padding: 9px;\n      }\n\n      .custom-liquid-reference-block .clrb-card-head {\n        display: block;\n        min-height: 132px;\n        margin-bottom: 8px;\n      }\n\n      .custom-liquid-reference-block .clrb-icon {\n        width: 46px;\n        height: 46px;\n        border-width: 2px;\n        margin-bottom: 9px;\n      }\n\n      .custom-liquid-reference-block .clrb-icon svg {\n        width: 68%;\n        height: 68%;\n        stroke-width: 4.3;\n      }\n\n      .custom-liquid-reference-block .clrb-title {\n        font-size: clamp(16px, 4.35vw, 19px);\n        line-height: 0.98;\n        letter-spacing: -0.045em;\n      }\n\n      .custom-liquid-reference-block .clrb-copy {\n        font-size: clamp(11.5px, 3.1vw, 13px);\n        line-height: 1.18;\n        font-weight: 800;\n      }\n\n      .custom-liquid-reference-block .clrb-image-wrap {\n        aspect-ratio: 1.42 / 1;\n        border-radius: 12px;\n      }\n\n      .custom-liquid-reference-block .clrb-footer {\n        align-items: center;\n        gap: 9px;\n        margin-top: 18px;\n      }\n\n      .custom-liquid-reference-block .clrb-paw {\n        width: 34px;\n        height: 34px;\n      }\n\n      .custom-liquid-reference-block .clrb-footer-text {\n        max-width: 310px;\n        text-align: left;\n        font-size: clamp(20px, 5.8vw, 27px);\n      }\n    }\n\n    @media (max-width: 374px) {\n      .custom-liquid-reference-block {\n        padding-left: 8px;\n        padding-right: 8px;\n      }\n\n      .custom-liquid-reference-block .clrb-grid {\n        gap: 8px;\n      }\n\n      .custom-liquid-reference-block .clrb-card {\n        padding: 8px;\n      }\n\n      .custom-liquid-reference-block .clrb-card-head {\n        min-height: 138px;\n      }\n\n      .custom-liquid-reference-block .clrb-title {\n        font-size: 15px;\n      }\n\n      .custom-liquid-reference-block .clrb-copy {\n        font-size: 11px;\n      }\n    }\n  </style>\n\n  <div class=\"clrb-shell\">\n    <h2 class=\"clrb-heading\">Why nail trimming feels <span>so stressful</span></h2>\n\n    <div class=\"clrb-grid\">\n      <article class=\"clrb-card\">\n        <div class=\"clrb-card-head\">\n          <div class=\"clrb-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 100 100\">\n              <path d=\"M30 70c8-15 11-27 10-39\" />\n              <path d=\"M44 29c8 9 15 17 23 22\" />\n              <path d=\"M28 72c11-3 22-6 35-16\" />\n              <path d=\"M54 39c-7 8-13 16-20 31\" />\n              <path d=\"M64 33c7 4 10 12 6 20\" />\n              <path d=\"M34 22c6 3 10 7 12 13\" />\n              <path d=\"M65 61l13 15\" />\n              <path d=\"M75 58l11 9\" />\n            </svg>\n          </div>\n          <div>\n            <h3 class=\"clrb-title\">Hard to see the quick</h3>\n            <p class=\"clrb-copy\">The biggest fear is cutting too deep.</p>\n          </div>\n        </div>\n        <div class=\"clrb-image-wrap\">\n          <img\n            class=\"clrb-image\"\n            src=\"https://cdn.shopify.com/s/files/1/0813/4626/5347/files/hard_to_seee.png?v=1778217084\"\n            alt=\"Close-up of a pet nail showing the quick\"\n            loading=\"lazy\"\n          >\n        </div>\n      </article>\n\n      <article class=\"clrb-card\">\n        <div class=\"clrb-card-head\">\n          <div class=\"clrb-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 100 100\">\n              <path d=\"M24 43c0-15 12-25 26-25s26 10 26 25v19c0 16-12 25-26 25S24 78 24 62V43z\" />\n              <path d=\"M29 31L16 14c-1 20 5 31 13 39\" />\n              <path d=\"M71 31l13-17c1 20-5 31-13 39\" />\n              <circle cx=\"39\" cy=\"51\" r=\"3\" />\n              <circle cx=\"61\" cy=\"51\" r=\"3\" />\n              <path d=\"M45 62c4 4 6 4 10 0\" />\n              <path d=\"M50 57v6\" />\n              <path d=\"M34 70c-7 2-12 7-15 14\" />\n              <path d=\"M66 70c7 2 12 7 15 14\" />\n            </svg>\n          </div>\n          <div>\n            <h3 class=\"clrb-title\">Pets get anxious</h3>\n            <p class=\"clrb-copy\">Stress makes every trim feel harder.</p>\n          </div>\n        </div>\n        <div class=\"clrb-image-wrap\">\n          <img\n            class=\"clrb-image\"\n            src=\"https://cdn.shopify.com/s/files/1/0813/4626/5347/files/anxious.png?v=1778217222\"\n            alt=\"Small anxious white dog resting on a soft surface\"\n            loading=\"lazy\"\n          >\n        </div>\n      </article>\n\n      <article class=\"clrb-card\">\n        <div class=\"clrb-card-head\">\n          <div class=\"clrb-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 100 100\">\n              <path d=\"M27 73h48\" />\n              <path d=\"M33 69c4-22 17-39 36-43-12 11-18 27-20 43\" />\n              <path d=\"M48 54c5-7 12-12 20-15\" />\n            </svg>\n          </div>\n          <div>\n            <h3 class=\"clrb-title\">Sharp after clipping</h3>\n            <p class=\"clrb-copy\">Rough edges can still scratch.</p>\n          </div>\n        </div>\n        <div class=\"clrb-image-wrap\">\n          <img\n            class=\"clrb-image\"\n            src=\"https://cdn.shopify.com/s/files/1/0813/4626/5347/files/edges.png?v=1778217302\"\n            alt=\"Close-up of a clipped pet nail with a sharp edge\"\n            loading=\"lazy\"\n          >\n        </div>\n      </article>\n\n      <article class=\"clrb-card\">\n        <div class=\"clrb-card-head\">\n          <div class=\"clrb-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 100 100\">\n              <path d=\"M29 24l8 14\" />\n              <path d=\"M59 18l11 12\" />\n              <path d=\"M76 47l-13 4\" />\n              <path d=\"M25 57l14-5\" />\n              <path d=\"M47 73l5-14\" />\n              <path d=\"M68 70l-9-8\" />\n              <path d=\"M42 35l11 6\" />\n              <path d=\"M21 40l8 5\" />\n              <path d=\"M77 25l5 9\" />\n            </svg>\n          </div>\n          <div>\n            <h3 class=\"clrb-title\">Messy cleanup</h3>\n            <p class=\"clrb-copy\">Nail pieces scatter everywhere.</p>\n          </div>\n        </div>\n        <div class=\"clrb-image-wrap\">\n          <img\n            class=\"clrb-image\"\n            src=\"https://cdn.shopify.com/s/files/1/0813/4626/5347/files/nails.png?v=1778217379\"\n            alt=\"Scattered pet nail fragments on a light surface\"\n            loading=\"lazy\"\n          >\n        </div>\n      </article>\n    </div>\n\n    <div class=\"clrb-footer\">\n      <div class=\"clrb-paw\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 100 100\">\n          <ellipse cx=\"22\" cy=\"42\" rx=\"12\" ry=\"18\" transform=\"rotate(-23 22 42)\" />\n          <ellipse cx=\"42\" cy=\"26\" rx=\"12\" ry=\"18\" transform=\"rotate(-8 42 26)\" />\n          <ellipse cx=\"62\" cy=\"26\" rx=\"12\" ry=\"18\" transform=\"rotate(8 62 26)\" />\n          <ellipse cx=\"80\" cy=\"42\" rx=\"12\" ry=\"18\" transform=\"rotate(23 80 42)\" />\n          <path d=\"M24 74c4-17 15-28 28-28s24 11 28 28c3 14-8 20-21 14-5-2-9-3-14-1-16 6-24 0-21-13z\" />\n        </svg>\n      </div>\n      <p class=\"clrb-footer-text\">Pawosa makes trims feel <span>safer, calmer, smoother, and cleaner.</span></p>\n    </div>\n  </div>\n</div>",
        "color_scheme": "background-1",
