    "collapsible_content_Vr7ChJ": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_content_r9MdDc": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "Will this latch fit into my vehicle's seatbelt buckle?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>The standard 0.83-inch (2.1 cm) stainless steel latch is designed to fit many standard vehicle seat-belt buckles. We recommend checking your vehicle's buckle dimensions and compatibility before ordering.</p>",
            "page": ""
          },
          "blocks": {}
        },
        "collapsible_row_content_7WhHAK": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "How does the bungee shock-absorbing buffer protect my dog?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>The elastic bungee core dampens sudden stops, sudden accelerations, and sharp turns, reducing stress and protecting your dog from sudden jerks.</p>",
            "page": ""
          },
          "blocks": {}
        },
        "collapsible_row_content_kdV9Lf": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "Does the tether allow my dog to move comfortably?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>Yes. The heavy-duty 360-degree anti-tangle swivel clasp and 20 to 32-inch adjustable nylon strap let your dog sit, lie down, or stand without tangling.</p>",
            "page": ""
          },
          "blocks": {}
        },
        "collapsible_row_content_LBnmdE": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "Should I attach the tether to a collar or a harness?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>For vehicle safety, always attach the tether to your dog's harness (such as our No-Pull Dog Harness) rather than a neck collar to prevent choking or neck strain.</p>",
            "page": ""
          },
          "blocks": {}
        }
      },
