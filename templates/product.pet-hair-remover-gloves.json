v class=\"pbc-choice\">\n            <span class=\"pbc-mark pbc-mark-bad\">—</span>\n            <span>Slides</span>\n          </div>\n        </div>\n\n        <div class=\"pbc-cell pbc-feature\">Food-grade material</div>\n        <div class=\"pbc-cell pbc-brand\">\n          <div class=\"pbc-choice\">\n            <span class=\"pbc-mark pbc-mark-good\">✓</span>\n            <span>Safe</span>\n          </div>\n        </div>\n        <div class=\"pbc-cell pbc-basic\">\n          <div class=\"pbc-choice\">\n            <span class=\"pbc-mark pbc-mark-bad\">—</span>\n            <span>Varies</span>\n          </div>\n        </div>\n\n        <div class=\"pbc-cell pbc-feature\">Easy to clean</div>\n        <div class=\"pbc-cell pbc-brand\">\n          <div class=\"pbc-choice\">\n            <span class=\"pbc-mark pbc-mark-good\">✓</span>\n            <span>Easy</span>\n          </div>\n        </div>\n        <div class=\"pbc-cell pbc-basic\">\n          <div class=\"pbc-choice\">\n            <span class=\"pbc-mark pbc-mark-bad\">—</span>\n            <span>Basic</span>\n          </div>\n        </div>\n\n        <div class=\"pbc-cell pbc-feature\">Built for play</div>\n        <div class=\"pbc-cell pbc-brand\">\n          <div class=\"pbc-choice\">\n            <span class=\"pbc-mark pbc-mark-good\">✓</span>\n            <span>Fun</span>\n          </div>\n        </div>\n        <div class=\"pbc-cell pbc-basic\">\n          <div class=\"pbc-choice\">\n            <span class=\"pbc-mark pbc-mark-bad\">—</span>\n            <span>Limited</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
