    "collapsible_content_Vr7ChJ": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_content_r9MdDc": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "Will it work on dark or black nails?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>The built-in LED illuminates the nail area to help you identify the quick more easily. For dark or opaque nails, we recommend trimming in small, gradual increments from the tip for optimal safety.</p>",
            "page": ""
          },
          "blocks": {}
        },
        "collapsible_row_content_7WhHAK": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "Is it safe for all pet sizes?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>Yes! It is suitable for cats and small-to-medium dogs. Multiple port sizes allow you to choose the appropriate opening for your pet's nail size and comfort.</p>",
            "page": ""
          },
          "blocks": {}
        },
        "collapsible_row_content_kdV9Lf": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "Will this hurt my pet?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>When used carefully as directed, it is designed for a gentle, comfortable grooming experience. The built-in LED light and safety guard help you see the quick and trim in small, gradual increments.</p>",
            "page": ""
          },
          "blocks": {}
        },
        "collapsible_row_content_LBnmdE": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "How often should I trim my pet\u2019s nails?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>Most pets do best with trims every 2\u20134 weeks. Keeping nails trimmed supports comfortable paw posture and helps protect furniture from scratches.</p>",
            "page": ""
          },
          "blocks": {}
        }
      },
