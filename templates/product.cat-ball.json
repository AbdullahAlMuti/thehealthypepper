            "row_content": "<p>Equipped with intelligent motion sensors, the ball rolls, spins, and automatically changes direction whenever it touches an obstacle, wall, or furniture, keeping cats actively entertained.</p>",
            "page": ""
          },
          "blocks": {}
        },
        "collapsible_row_content_7WhHAK": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "Is the rolling ball suitable for all floor types?",
            "icon": "",
            "filled_icon": false,
            "row_content": "<p>Yes. The soft, durable silicone shell rolls smoothly and quietly across hardwood, tile, laminate, and low-pile rugs without scratching floors or making loud noises.</p>",
            "page": ""
          },
          "blocks": {}
        },
        "collapsible_row_content_kdV9Lf": {
