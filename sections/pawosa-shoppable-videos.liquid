{% comment %}
  Pawosa Shoppable Videos Section
  Online Store 2.0 Theme Section for vertical shoppable video carousels.
  Fixed 5-Slot Virtual Infinite Loop Edition with 9:16 aspect ratio & responsive 5/3/2 layout slots.
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} .pawosa-shoppable-video {
    --pawosa-bg: {{ section.settings.bg_color | default: '#121212' }};
    --pawosa-text: {{ section.settings.text_color | default: '#ffffff' }};
    --pawosa-accent: {{ section.settings.accent_color | default: '#16877F' }};
    --pawosa-accent-hover: #0F6F69;
    --pawosa-padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --pawosa-padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    --pawosa-card-radius: {{ section.settings.card_radius | default: 16 }}px;
    --pawosa-card-width-desktop: {{ section.settings.desktop_card_width | default: 280 }}px;
    --pawosa-card-gap: {{ section.settings.desktop_card_gap | default: 20 }}px;
    --pawosa-mobile-card-width: {{ section.settings.mobile_card_width | default: 78 }}vw;

    background-color: var(--pawosa-bg);
    color: var(--pawosa-text);
    padding-top: var(--pawosa-padding-top);
    padding-bottom: var(--pawosa-padding-bottom);
    position: relative;
    overflow: hidden;
    font-family: inherit;
  }

  .pawosa-shoppable-video__container {
    width: 100%;
    max-width: {{ section.settings.max_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  {% if section.settings.full_width %}
  .pawosa-shoppable-video__container {
    max-width: 100%;
    padding: 0 16px;
  }
  {% endif %}

  /* Header */
  .pawosa-shoppable-video__header {
    text-align: {{ section.settings.heading_alignment | default: 'center' }};
    margin-bottom: 40px;
  }

  .pawosa-shoppable-video__eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--pawosa-accent);
    margin-bottom: 8px;
  }

  .pawosa-shoppable-video__heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--pawosa-text);
    margin: 0 0 12px 0;
    line-height: 1.2;
  }

  .pawosa-shoppable-video__description {
    font-size: 1rem;
    color: #a0a0a0;
    margin: 0 auto;
    max-width: 600px;
    line-height: 1.5;
  }

  /* Carousel Wrapper */
  .pawosa-shoppable-video__carousel-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 0;
    min-height: 480px;
  }

  /* Desktop Track */
  .pawosa-shoppable-video__track {
    position: relative;
    width: 100%;
    height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1000px;
    user-select: none;
    touch-action: pan-y;
  }

  /* Video Card Styling - Strict 9:16 Aspect Ratio */
  .pawosa-shoppable-video__card {
    position: absolute;
    width: var(--pawosa-card-width-desktop);
    aspect-ratio: 9 / 16;
    border-radius: var(--pawosa-card-radius);
    overflow: hidden;
    background: #1e1e1e;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-sizing: border-box;
    cursor: pointer;
    user-select: none;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.4s ease,
                filter 0.4s ease;
    will-change: transform, opacity;
  }

  .pawosa-shoppable-video__card:focus-visible {
    outline: 2px solid var(--pawosa-accent);
    outline-offset: 4px;
  }

  /* Stacked Virtual Slot Positions for Desktop (5 Cards Visible) */
  .pawosa-shoppable-video__card[data-state="active"] {
    transform: translate3d(0, 0, 0) scale(1);
    opacity: 1;
    z-index: 10;
    filter: brightness(1);
    border: 2px solid rgba(255, 255, 255, 0.85);
  }

  .pawosa-shoppable-video__card[data-state="prev-1"] {
    transform: translate3d(calc(-1 * (var(--pawosa-card-width-desktop) * 0.88 + var(--pawosa-card-gap))), 0, -30px) scale(0.86);
    opacity: 0.9;
    z-index: 5;
    filter: brightness(0.8);
  }

  .pawosa-shoppable-video__card[data-state="next-1"] {
    transform: translate3d(calc(var(--pawosa-card-width-desktop) * 0.88 + var(--pawosa-card-gap)), 0, -30px) scale(0.86);
    opacity: 0.9;
    z-index: 5;
    filter: brightness(0.8);
  }

  .pawosa-shoppable-video__card[data-state="prev-2"] {
    transform: translate3d(calc(-1 * (var(--pawosa-card-width-desktop) * 1.62 + var(--pawosa-card-gap) * 2)), 0, -60px) scale(0.72);
    opacity: 0.7;
    z-index: 2;
    filter: brightness(0.65);
  }

  .pawosa-shoppable-video__card[data-state="next-2"] {
    transform: translate3d(calc(var(--pawosa-card-width-desktop) * 1.62 + var(--pawosa-card-gap) * 2), 0, -60px) scale(0.72);
    opacity: 0.7;
    z-index: 2;
    filter: brightness(0.65);
  }

  .pawosa-shoppable-video__card[data-state="hidden"] {
    transform: translate3d(0, 0, -120px) scale(0.5);
    opacity: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* Card Media & Overlays - Object-Fit Cover for 9:16 */
  .pawosa-shoppable-video__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #000;
  }

  .pawosa-shoppable-video__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
    z-index: 1;
  }

  .pawosa-shoppable-video__card video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .pawosa-shoppable-video__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0) 40%, rgba(0,0,0,0.85) 100%);
    z-index: 2;
    pointer-events: none;
  }

  /* Badges */
  .pawosa-shoppable-video__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--pawosa-accent);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    z-index: 3;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .pawosa-shoppable-video__discount-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #ff2d55;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 4px;
    z-index: 4;
    text-transform: uppercase;
  }

  /* Sound Badge Indicator */
  .pawosa-shoppable-video__sound-badge {
    position: absolute;
    bottom: 64px;
    right: 12px;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: 16px;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .pawosa-shoppable-video__sound-badge:hover {
    background: rgba(0, 0, 0, 0.85);
    transform: scale(1.05);
  }

  /* Play Button Overlay */
  .pawosa-shoppable-video__play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    border: 2px solid #00f2fe;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: transform 0.25s ease;
  }

  .pawosa-shoppable-video__card:hover .pawosa-shoppable-video__play-btn {
    transform: translate(-50%, -50%) scale(1.12);
  }

  .pawosa-shoppable-video__play-btn svg {
    width: 20px;
    height: 20px;
    fill: #ffffff;
    margin-left: 2px;
  }

  /* Card Bottom Info */
  .pawosa-shoppable-video__card-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pawosa-shoppable-video__card-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pawosa-shoppable-video__product-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.78rem;
    color: #ffffff;
    font-weight: 500;
    margin-top: 4px;
    align-self: flex-start;
  }

  .pawosa-shoppable-video__product-tag svg {
    width: 14px;
    height: 14px;
    fill: var(--pawosa-accent);
  }

  /* Navigation Arrow Buttons */
  .pawosa-shoppable-video__nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    color: #121212;
    border: none;
    cursor: pointer;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
  }

  .pawosa-shoppable-video__nav-btn:hover {
    background: var(--pawosa-accent);
    color: #ffffff;
    transform: translateY(-50%) scale(1.08);
  }

  .pawosa-shoppable-video__nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    pointer-events: none;
  }

  .pawosa-shoppable-video__nav-btn--prev {
    left: 10px;
  }

  .pawosa-shoppable-video__nav-btn--next {
    right: 10px;
  }

  .pawosa-shoppable-video__nav-btn svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  /* Grid Mode CSS (Watch & Buy Equal Row) */
  .pawosa-shoppable-video[data-layout-mode="grid"] .pawosa-shoppable-video__track {
    display: flex;
    height: auto;
    gap: var(--pawosa-card-gap);
    justify-content: center;
    align-items: stretch;
    perspective: none;
    overflow-x: auto;
    padding-bottom: 20px;
  }

  .pawosa-shoppable-video[data-layout-mode="grid"] .pawosa-shoppable-video__card {
    position: relative;
    flex: 1 1 0;
    min-width: 200px;
    max-width: 260px;
    height: auto;
    aspect-ratio: auto;
    transform: none !important;
    opacity: 1 !important;
    filter: none !important;
    background: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--pawosa-card-radius);
    display: flex;
    flex-direction: column;
  }

  .pawosa-shoppable-video[data-layout-mode="grid"] .pawosa-shoppable-video__card-media-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 14;
    overflow: hidden;
    background: #000;
    border-top-left-radius: calc(var(--pawosa-card-radius) - 1px);
    border-top-right-radius: calc(var(--pawosa-card-radius) - 1px);
  }

  .pawosa-shoppable-video[data-layout-mode="grid"] .pawosa-shoppable-video__grid-thumb {
    position: absolute;
    bottom: 8px;
    left: 12px;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: #ffffff;
    border: 2px solid #ffffff;
    object-fit: cover;
    z-index: 5;
  }

  .pawosa-shoppable-video[data-layout-mode="grid"] .pawosa-shoppable-video__card-info {
    position: relative;
    background: #ffffff;
    padding: 16px 12px 14px 12px;
    color: #121212;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-bottom-left-radius: var(--pawosa-card-radius);
    border-bottom-right-radius: var(--pawosa-card-radius);
  }

  .pawosa-shoppable-video[data-layout-mode="grid"] .pawosa-shoppable-video__card-title {
    color: #121212;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pawosa-shoppable-video[data-layout-mode="grid"] .pawosa-shoppable-video__product-tag {
    display: none;
  }

  .pawosa-shoppable-video[data-layout-mode="grid"] .pawosa-shoppable-video__grid-rating {
    color: #ffb400;
    font-size: 0.8rem;
    letter-spacing: 1px;
  }

  .pawosa-shoppable-video[data-layout-mode="grid"] .pawosa-shoppable-video__grid-price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #e53935;
  }

  .pawosa-shoppable-video[data-layout-mode="grid"] .pawosa-shoppable-video__grid-compare-price {
    font-size: 0.8rem;
    color: #888888;
    text-decoration: line-through;
    font-weight: 400;
  }

  /* Progress Dots */
  .pawosa-shoppable-video__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .pawosa-shoppable-video__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .pawosa-shoppable-video__dot.is-active {
    background: var(--pawosa-accent);
    transform: scale(1.3);
  }

  /* Tablet Responsive Media Query (3 Visible Cards) */
  @media (min-width: 750px) and (max-width: 990px) {
    .pawosa-shoppable-video__card[data-state="prev-2"],
    .pawosa-shoppable-video__card[data-state="next-2"] {
      opacity: 0 !important;
      pointer-events: none !important;
      transform: translate3d(0, 0, -100px) scale(0.5) !important;
    }
  }

  /* Mobile Responsive Media Query (2 Cards Peek + Unified Virtual Slot Engine) */
  @media (max-width: 749px) {
    .pawosa-shoppable-video__carousel-wrapper {
      padding: 0;
      min-height: 0;
    }

    .pawosa-shoppable-video__track {
      height: 540px;
      overflow: visible;
      padding: 0;
    }

    /* Mobile Virtual Slot Transforms */
    .pawosa-shoppable-video__card {
      position: absolute;
      width: 72vw;
      max-width: 340px;
      aspect-ratio: 9 / 16;
      transform: translate3d(0, 0, 0) scale(1);
    }

    .pawosa-shoppable-video__card[data-state="active"] {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 1;
      z-index: 10;
      filter: brightness(1);
    }

    .pawosa-shoppable-video__card[data-state="prev-1"] {
      transform: translate3d(calc(-72vw - 10px), 0, 0) scale(0.9);
      opacity: 0.85;
      z-index: 5;
      filter: brightness(0.8);
    }

    .pawosa-shoppable-video__card[data-state="next-1"] {
      transform: translate3d(calc(72vw + 10px), 0, 0) scale(0.9);
      opacity: 0.85;
      z-index: 5;
      filter: brightness(0.8);
    }

    .pawosa-shoppable-video__card[data-state="prev-2"],
    .pawosa-shoppable-video__card[data-state="next-2"],
    .pawosa-shoppable-video__card[data-state="hidden"] {
      opacity: 0;
      pointer-events: none;
      transform: translate3d(0, 0, -80px) scale(0.6);
    }

    .pawosa-shoppable-video__nav-btn {
      display: none;
    }
  }

  /* Pure Video Modal Overlay */
  .pawosa-shoppable-video__modal {
    position: fixed;
    inset: 0;
    z-index: 999999;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .pawosa-shoppable-video__modal.is-open {
    opacity: 1;
    visibility: visible;
  }

  .pawosa-shoppable-video__modal-content {
    position: relative;
    width: 90%;
    max-width: 440px;
    height: 82vh;
    max-height: 750px;
    aspect-ratio: 9 / 16;
    background: #000000;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    overflow: hidden;
    transform: scale(0.95);
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .pawosa-shoppable-video__modal.is-open .pawosa-shoppable-video__modal-content {
    transform: scale(1);
  }

  .pawosa-shoppable-video__modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 30;
    transition: background 0.2s ease;
  }

  .pawosa-shoppable-video__modal-close:hover {
    background: var(--pawosa-accent);
  }

  .pawosa-shoppable-video__modal-video-container {
    flex: 1;
    width: 100%;
    height: 100%;
    position: relative;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pawosa-shoppable-video__modal-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Empty State */
  .pawosa-shoppable-video__empty-state {
    text-align: center;
    padding: 60px 20px;
    border: 2px dashed rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    color: #a0a0a0;
  }
{%- endstyle -%}

<div class="pawosa-shoppable-video"
     id="PawosaShoppableVideo-{{ section.id }}"
     data-layout-mode="{{ section.settings.layout_mode | default: 'stacked' }}"
     data-autoplay="{{ section.settings.enable_autoplay }}"
     data-autoplay-video="{{ section.settings.autoplay_video }}"
     data-autoplay-speed="{{ section.settings.autoplay_speed | default: 4 | times: 1000 }}">
  <div class="pawosa-shoppable-video__container">
    {%- if section.settings.show_heading -%}
      <div class="pawosa-shoppable-video__header">
        {%- if section.settings.eyebrow != blank -%}
          <div class="pawosa-shoppable-video__eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pawosa-shoppable-video__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="pawosa-shoppable-video__description">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {%- comment -%} Automatic Duplication Engine for < 5 Video Blocks {%- endcomment -%}
      {%- assign total_blocks = section.blocks.size -%}
      {%- assign repeat_count = 1 -%}
      {%- if total_blocks == 1 -%}
        {%- assign repeat_count = 5 -%}
      {%- elsif total_blocks == 2 -%}
        {%- assign repeat_count = 3 -%}
      {%- elsif total_blocks == 3 or total_blocks == 4 -%}
        {%- assign repeat_count = 2 -%}
      {%- endif -%}

      <div class="pawosa-shoppable-video__carousel-wrapper">
        {%- if section.settings.show_arrows -%}
          <button class="pawosa-shoppable-video__nav-btn pawosa-shoppable-video__nav-btn--prev" aria-label="Previous Video">
            <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
          </button>
        {%- endif -%}

        <div class="pawosa-shoppable-video__track">
          {%- assign card_global_index = 0 -%}
          {%- for rep in (1..repeat_count) -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.enable_block -%}
                {%- assign product = block.settings.product -%}

                {%- comment -%} Resolve video URL {%- endcomment -%}
                {%- assign video_url = '' -%}
                {%- if block.settings.shopify_video != blank -%}
                  {%- for source in block.settings.shopify_video.sources -%}
                    {%- if source.format == 'mp4' -%}
                      {%- assign video_url = source.url -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if video_url == '' and block.settings.shopify_video.sources.first -%}
                    {%- assign video_url = block.settings.shopify_video.sources.first.url -%}
                  {%- endif -%}
                {%- elsif block.settings.external_video_url != blank -%}
                  {%- assign video_url = block.settings.external_video_url -%}
                {%- endif -%}

                {%- comment -%} Resolve poster image {%- endcomment -%}
                {%- assign poster_url = '' -%}
                {%- if block.settings.poster_image != blank -%}
                  {%- assign poster_url = block.settings.poster_image | image_url: width: 800 -%}
                {%- elsif block.settings.shopify_video != blank and block.settings.shopify_video.preview_image != blank -%}
                  {%- assign poster_url = block.settings.shopify_video.preview_image | image_url: width: 800 -%}
                {%- elsif product != blank and product.featured_image != blank -%}
                  {%- assign poster_url = product.featured_image | image_url: width: 800 -%}
                {%- endif -%}

                <div class="pawosa-shoppable-video__card"
                     data-index="{{ card_global_index }}"
                     data-block-id="{{ block.id }}"
                     data-state="{% if card_global_index == 0 %}active{% elsif card_global_index == 1 %}next-1{% elsif card_global_index == 2 %}next-2{% else %}hidden{% endif %}"
                     tabindex="0"
                     aria-label="{{ block.settings.accessibility_label | default: block.settings.title | default: product.title | default: 'Shoppable video' | escape }}"
                     {{ block.shopify_attributes }}>
                  
                  <div class="pawosa-shoppable-video__overlay"></div>

                  {%- if block.settings.badge_text != blank and section.settings.show_product_count -%}
                    <span class="pawosa-shoppable-video__badge">{{ block.settings.badge_text | escape }}</span>
                  {%- endif -%}

                  {%- if block.settings.discount_badge_text != blank and section.settings.show_discount -%}
                    <span class="pawosa-shoppable-video__discount-badge">{{ block.settings.discount_badge_text | escape }}</span>
                  {%- endif -%}

                  {%- if section.settings.show_sound_badge -%}
                    <div class="pawosa-shoppable-video__sound-badge">
                      <span>🔊 Tap for Sound</span>
                    </div>
                  {%- endif -%}

                  {%- if poster_url != blank -%}
                    <img class="pawosa-shoppable-video__poster" src="{{ poster_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="400" height="711">
                  {%- endif -%}

                  {%- if video_url != blank -%}
                    <video class="pawosa-shoppable-video__media"
                           data-src="{{ video_url }}"
                           playsinline
                           muted
                           loop
                           autoplay
                           preload="metadata"></video>
                  {%- endif -%}

                  {%- if section.settings.show_play_button -%}
                    <button class="pawosa-shoppable-video__play-btn" aria-label="Play Video">
                      <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    </button>
                  {%- endif -%}

                  {%- if product != blank and product.featured_image != blank -%}
                    <img class="pawosa-shoppable-video__grid-thumb" src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title | escape }}" loading="lazy" width="44" height="44">
                  {%- endif -%}

                  <div class="pawosa-shoppable-video__card-info">
                    {%- if block.settings.title != blank -%}
                      <h3 class="pawosa-shoppable-video__card-title">{{ block.settings.title | escape }}</h3>
                    {%- elsif product != blank -%}
                      <h3 class="pawosa-shoppable-video__card-title">{{ product.title | escape }}</h3>
                    {%- endif -%}

                    {%- if product != blank -%}
                      <div class="pawosa-shoppable-video__product-tag">
                        <svg viewBox="0 0 24 24"><path d="M19 6h-2c0-2.76-2.24-5-5-5S7 3.24 7 6H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-7-3c1.66 0 3 1.34 3 3H9c0-1.66 1.34-3 3-3zm7 17H5V8h2v2c0 .55.45 1 1 1s1-.45 1-1V8h6v2c0 .55.45 1 1 1s1-.45 1-1V8h2v12z"/></svg>
                        <span>{{ product.price | money }}</span>
                      </div>

                      {%- comment -%}
                        Removed a hardcoded five-star rating that rendered on
                        every product card regardless of whether the product
                        had any reviews at all. Judge.me is installed on this
                        store; if a rating belongs here it should come from
                        real review data, not a literal.
                      {%- endcomment -%}

                      <div class="pawosa-shoppable-video__grid-price-row">
                        <span>{{ product.price | money }}</span>
                        {%- if product.compare_at_price > product.price -%}
                          <span class="pawosa-shoppable-video__grid-compare-price">{{ product.compare_at_price | money }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>

                  {%- comment -%} JSON Video Data Output {%- endcomment -%}
                  <script type="application/json" class="pawosa-shoppable-video-data">
                    {
                      "blockId": {{ block.id | json }},
                      "videoUrl": {{ video_url | json }},
                      "title": {{ block.settings.title | default: product.title | json }}
                    }
                  </script>
                </div>
                {%- assign card_global_index = card_global_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.show_arrows -%}
          <button class="pawosa-shoppable-video__nav-btn pawosa-shoppable-video__nav-btn--next" aria-label="Next Video">
            <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
          </button>
        {%- endif -%}
      </div>

      {%- if section.settings.show_dots -%}
        <div class="pawosa-shoppable-video__dots">
          {%- for block in section.blocks -%}
            {%- if block.settings.enable_block -%}
              <button class="pawosa-shoppable-video__dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="pawosa-shoppable-video__empty-state">
        <p>No video blocks added yet. Click "Add block" in the Theme Editor to add your shoppable videos.</p>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Modal Markup - Pure Video Player {%- endcomment -%}
  <div class="pawosa-shoppable-video__modal" id="PawosaShoppableVideoModal-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Video Player Modal">
    <div class="pawosa-shoppable-video__modal-content">
      <button class="pawosa-shoppable-video__modal-close" aria-label="Close modal">&times;</button>

      <div class="pawosa-shoppable-video__modal-video-container">
        <video class="pawosa-shoppable-video__modal-video" playsinline loop controls></video>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    function initPawosaShoppableVideo(sectionId) {
      var section = document.getElementById('PawosaShoppableVideo-' + sectionId);
      if (!section) return;

      var track = section.querySelector('.pawosa-shoppable-video__track');
      var cards = section.querySelectorAll('.pawosa-shoppable-video__card');
      var dots = section.querySelectorAll('.pawosa-shoppable-video__dot');
      var prevBtn = section.querySelector('.pawosa-shoppable-video__nav-btn--prev');
      var nextBtn = section.querySelector('.pawosa-shoppable-video__nav-btn--next');
      var modal = section.querySelector('.pawosa-shoppable-video__modal');
      var modalVideo = modal ? modal.querySelector('.pawosa-shoppable-video__modal-video') : null;
      var modalClose = modal ? modal.querySelector('.pawosa-shoppable-video__modal-close') : null;

      var activeIndex = 0;
      var totalCards = cards.length;

      if (!totalCards) return;

      // Carousel Autoplay Timer Logic
      var enableAutoplay = section.getAttribute('data-autoplay') === 'true';
      var autoplaySpeed = parseInt(section.getAttribute('data-autoplay-speed'), 10) || 4000;
      var autoplayTimer = null;

      function startAutoplay() {
        if (!enableAutoplay) return;
        stopAutoplay();
        autoplayTimer = setInterval(function() {
          if (!modal || !modal.classList.contains('is-open')) {
            goToSlide(activeIndex + 1);
          }
        }, autoplaySpeed);
      }

      function stopAutoplay() {
        if (autoplayTimer) {
          clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      if (enableAutoplay) {
        startAutoplay();
        section.addEventListener('mouseenter', stopAutoplay);
        section.addEventListener('mouseleave', startAutoplay);
      }

      // IntersectionObserver for video autoplay performance
      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            var activeCard = section.querySelector('.pawosa-shoppable-video__card[data-state="active"]');
            var video = activeCard ? activeCard.querySelector('video') : null;
            if (video) {
              if (entry.isIntersecting) {
                video.play().catch(function(){});
              } else {
                video.pause();
              }
            }
          });
        }, { threshold: 0.3 });

        observer.observe(section);
      }

      // Virtual Fixed 5-Slot Infinite Looping Engine
      function updateSlots() {
        cards.forEach(function(card, idx) {
          var diff = (idx - activeIndex) % totalCards;
          if (diff < -Math.floor(totalCards / 2)) diff += totalCards;
          if (diff > Math.floor((totalCards - 1) / 2)) diff -= totalCards;

          var state = 'hidden';
          if (diff === 0) state = 'active';
          else if (diff === -1) state = 'prev-1';
          else if (diff === 1) state = 'next-1';
          else if (diff === -2) state = 'prev-2';
          else if (diff === 2) state = 'next-2';

          card.setAttribute('data-state', state);

          var enableVideoAutoplay = section.getAttribute('data-autoplay-video') !== 'false';

          var video = card.querySelector('video');
          if (video) {
            if (state === 'active' && enableVideoAutoplay) {
              var src = video.getAttribute('data-src');
              if (src && !video.src) video.src = src;
              video.muted = true;
              video.play().catch(function(){});
            } else {
              video.pause();
            }
          }
        });

        // Update dot indicators
        dots.forEach(function(dot, idx) {
          var activeDotIndex = (activeIndex % dots.length + dots.length) % dots.length;
          dot.classList.toggle('is-active', idx === activeDotIndex);
        });
      }

      function goToSlide(index) {
        activeIndex = (index % totalCards + totalCards) % totalCards;
        updateSlots();
      }

      if (prevBtn) prevBtn.addEventListener('click', function() { goToSlide(activeIndex - 1); });
      if (nextBtn) nextBtn.addEventListener('click', function() { goToSlide(activeIndex + 1); });

      dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          var idx = parseInt(this.getAttribute('data-index'), 10);
          goToSlide(idx);
        });
      });

      cards.forEach(function(card, index) {
        card.addEventListener('click', function() {
          if (index !== activeIndex) {
            goToSlide(index);
          } else {
            openModal(card);
          }
        });
      });

      // Unified Drag & Touch Swipe Handling (Mobile + Desktop)
      var startX = 0;
      var startY = 0;
      var isDragging = false;
      var isHorizontalSwipe = null;

      if (track) {
        // Touch Start — capture initial position
        track.addEventListener('touchstart', function(e) {
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
          isDragging = true;
          isHorizontalSwipe = null;
        }, { passive: true });

        // Touch Move — detect horizontal vs vertical early, block scroll if horizontal
        track.addEventListener('touchmove', function(e) {
          if (!isDragging) return;
          var dx = e.touches[0].clientX - startX;
          var dy = e.touches[0].clientY - startY;
          if (isHorizontalSwipe === null) {
            isHorizontalSwipe = Math.abs(dx) > Math.abs(dy);
          }
          if (isHorizontalSwipe) {
            e.preventDefault(); // block browser page scroll during horizontal swipe
          }
        }, { passive: false });

        // Touch End — commit slide change
        track.addEventListener('touchend', function(e) {
          if (!isDragging || !isHorizontalSwipe) { isDragging = false; return; }
          var diffX = e.changedTouches[0].clientX - startX;
          if (diffX < -30) goToSlide(activeIndex + 1);
          else if (diffX > 30) goToSlide(activeIndex - 1);
          isDragging = false;
          isHorizontalSwipe = null;
        }, { passive: true });

        // Mouse drag (desktop)
        track.addEventListener('mousedown', function(e) {
          startX = e.clientX;
          isDragging = true;
        });

        track.addEventListener('mouseup', function(e) {
          if (!isDragging) return;
          var diffX = e.clientX - startX;
          if (diffX < -40) goToSlide(activeIndex + 1);
          else if (diffX > 40) goToSlide(activeIndex - 1);
          isDragging = false;
        });

        track.addEventListener('mouseleave', function() {
          isDragging = false;
        });
      }

      // Keyboard Navigation
      section.addEventListener('keydown', function(e) {
        if (modal && modal.classList.contains('is-open')) return;
        if (e.key === 'ArrowLeft') goToSlide(activeIndex - 1);
        if (e.key === 'ArrowRight') goToSlide(activeIndex + 1);
      });

      // Pure Video Modal Logic
      function openModal(card) {
        var scriptTag = card.querySelector('.pawosa-shoppable-video-data');
        if (!scriptTag) return;

        try {
          var data = JSON.parse(scriptTag.textContent);

          if (modalVideo && data.videoUrl) {
            modalVideo.src = data.videoUrl;
            modalVideo.currentTime = 0;
            modalVideo.play().catch(function(){});
          }

          modal.classList.add('is-open');
          document.body.style.overflow = 'hidden';
        } catch(e) {
          console.error('Error opening video modal', e);
        }
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('is-open');
        document.body.style.overflow = '';
        if (modalVideo) {
          modalVideo.pause();
          modalVideo.src = '';
        }
      }

      if (modalClose) modalClose.addEventListener('click', closeModal);
      if (modal) {
        modal.addEventListener('click', function(e) {
          if (e.target === modal) closeModal();
        });
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.classList.contains('is-open')) {
          closeModal();
        }
      });

      updateSlots();
    }

    document.addEventListener('DOMContentLoaded', function() {
      initPawosaShoppableVideo('{{ section.id }}');
    });

    if (window.Shopify && window.Shopify.designMode) {
      document.addEventListener('shopify:section:load', function(e) {
        if (e.detail.sectionId === '{{ section.id }}') {
          initPawosaShoppableVideo('{{ section.id }}');
        }
      });
    }
  })();
</script>

