{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .trust-pillars {
    background-color: #171A60;
    color: #FFFFFF;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .trust-pillars__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 3rem;
  }

  @media screen and (min-width: 750px) {
    .trust-pillars__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .trust-pillars__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .trust-pillars__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.2rem;
    padding: 2rem 1rem;
  }

  .trust-pillars__icon {
    font-size: 2.8rem;
    line-height: 1;
  }

  .trust-pillars__title {
    font-family: 'Inter', sans-serif !important;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0;
  }

  .trust-pillars__desc {
    font-family: 'Inter', sans-serif !important;
    font-size: 1.3rem;
    color: #CCCCCC;
    line-height: 1.4;
    margin: 0;
  }
{%- endstyle -%}

<div class="trust-pillars section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="trust-pillars__grid">
      <div class="trust-pillars__item">
        <span class="trust-pillars__icon">🚚</span>
        <h3 class="trust-pillars__title">Express Delivery</h3>
        <p class="trust-pillars__desc">Complimentary nationwide shipping across Bangladesh on all executive orders.</p>
      </div>

      <div class="trust-pillars__item">
        <span class="trust-pillars__icon">🧵</span>
        <h3 class="trust-pillars__title">100-Day Guarantee</h3>
        <p class="trust-pillars__desc">Premium long-staple cotton durability and seam precision commitment.</p>
      </div>

      <div class="trust-pillars__item">
        <span class="trust-pillars__icon">🔄</span>
        <h3 class="trust-pillars__title">Doorstep Exchange</h3>
        <p class="trust-pillars__desc">Hassle-free 7-day size exchange right at your doorstep.</p>
      </div>

      <div class="trust-pillars__item">
        <span class="trust-pillars__icon">📞</span>
        <h3 class="trust-pillars__title">Stylist Support</h3>
        <p class="trust-pillars__desc">Direct concierge line +880 1972-562464 for fit & wardrobe advice.</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust & Value Pillars",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Trust & Value Pillars"
    }
  ]
}
{% endschema %}
